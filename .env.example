# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id

# ======================================================
# IMPORTANT SECURITY NOTES:
# ======================================================
#
# 1. NEVER add SUPABASE_SERVICE_ROLE_KEY to this file!
#    Service role keys must ONLY be in Edge Function secrets.
#
# 2. The VITE_SUPABASE_ANON_KEY is safe to expose in client code.
#    It's designed to be public - security is enforced by RLS policies.
#
# 3. Remove .env from git tracking:
#    git rm --cached .env
#    git commit -m 'Remove .env from version control'
#
# 4. Copy this file to .env and fill in your values:
#    cp .env.example .env

# Push Notifications Configuration
# VAPID keys for Web Push Notifications
# Generate using: npx web-push generate-vapid-keys
# Or visit: https://vapidkeys.com/
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Note: VAPID private key should ONLY be stored in Edge Function secrets,
# never in client-side environment variables

# ======================================================
# SUPABASE EDGE FUNCTION SECRETS
# ======================================================
# The following environment variables must be set as Supabase secrets,
# NOT in this .env file. Set them using:
#   supabase secrets set VARIABLE_NAME=value
#
# Or via Supabase Dashboard:
#   Project Settings > Edge Functions > Secrets
#
# Required for SMS/Phone Verification (Twilio Verify):
# - TWILIO_ACCOUNT_SID: Your Twilio Account SID (starts with AC...)
# - TWILIO_AUTH_TOKEN: Your Twilio Auth Token
# - TWILIO_VERIFY_SERVICE_SID: Your Twilio Verify Service SID (starts with VA...)
# - TWILIO_PHONE_NUMBER: Your Twilio phone number for regular SMS (optional)
#
# Get these from: https://console.twilio.com/
