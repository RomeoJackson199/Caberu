{
  "version": "1.0.0",
  "description": "Caberu GDPR Data Retention Policy Configuration",
  "last_updated": "2026-02-10",
  "policies": {
    "call_recordings": {
      "retention_days": 30,
      "action": "delete",
      "legal_basis": "Consent - auto-expire after processing",
      "table": "phone_usage"
    },
    "voice_messages": {
      "retention_days": 30,
      "action": "delete",
      "legal_basis": "Consent - temporary storage",
      "table": "phone_usage"
    },
    "ai_transcripts": {
      "retention_days": 90,
      "action": "delete",
      "legal_basis": "Consent - AI processing records",
      "table": "communication_logs"
    },
    "chat_messages": {
      "retention_days": 90,
      "action": "delete",
      "legal_basis": "Contract performance",
      "table": "messages"
    },
    "sms_notifications": {
      "retention_days": 90,
      "action": "delete",
      "legal_basis": "Contract performance",
      "table": "sms_notifications"
    },
    "email_logs": {
      "retention_days": 90,
      "action": "delete",
      "legal_basis": "Contract performance",
      "table": "email_event_logs"
    },
    "appointment_history": {
      "retention_days": 2555,
      "action": "anonymize",
      "legal_basis": "Legal obligation - Belgian healthcare records law",
      "table": "appointments"
    },
    "patient_data": {
      "retention_days": 730,
      "action": "anonymize",
      "legal_basis": "Contract performance - 2 years after last interaction",
      "table": "patients"
    },
    "billing_records": {
      "retention_days": 2555,
      "action": "anonymize",
      "legal_basis": "Legal obligation - Belgian tax law (7 years)",
      "table": "payment_requests"
    },
    "prescriptions": {
      "retention_days": 2555,
      "action": "anonymize",
      "legal_basis": "Legal obligation - Belgian medical records law",
      "table": "prescriptions"
    },
    "treatment_plans": {
      "retention_days": 2555,
      "action": "anonymize",
      "legal_basis": "Legal obligation - Belgian medical records law",
      "table": "treatment_plans"
    },
    "audit_logs": {
      "retention_days": 2555,
      "action": "delete",
      "legal_basis": "Legal obligation - Compliance audit trail",
      "table": "gdpr_audit_log"
    },
    "anonymized_statistics": {
      "retention_days": -1,
      "action": "keep",
      "legal_basis": "Legitimate interest - Service improvement",
      "table": null
    }
  }
}
